    .admin-panel { display: none; position: fixed; top: 0; right: 0; width: 100%; max-width: 450px; height: 100vh; background: white; z-index: 1050; box-shadow: -5px 0 25px rgba(0,0,0,0.15); overflow-y: auto; padding: 30px; }
    .admin-panel.active { display: block; }
