    /* Admin Panel */
    .admin-toggle { position: fixed; bottom: 25px; right: 25px; z-index: 1000; background: var(--gold); color: #111; border: none; border-radius: 50%; width: 60px; height: 60px; font-size: 1.5rem; box-shadow: 0 5px 20px rgba(0,0,0,0.3); cursor: pointer; transition: 0.3s; display: flex; align-items: center; justify-content: center; }
