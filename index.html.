  <script>
    // --- Navbar Scroll Effect ---
    window.addEventListener('scroll', () => {
      document.getElementById('mainNav').classList.toggle('scrolled', window.scrollY > 50);
    });

    // --- Animations on Scroll ---
    function reveal() {
      var reveals = document.querySelectorAll(".reveal");
      for (var i = 0; i < reveals.length; i++) {
        var windowHeight = window.innerHeight;
        var elementTop = reveals[i].getBoundingClientRect().top;
        var elementVisible = 100;
        if (elementTop < windowHeight - elementVisible) {
          reveals[i].classList.add("active");
        }
      }
    }
    window.addEventListener("scroll", reveal);
    reveal(); // Trigger on load

    // --- Data Management (LocalStorage) ---
    const defaultData = {
      profileImage: "https://via.placeholder.com/250",
      posts: [
        {
          id: 1,
          title: "Projet City Mall",
          image: "https://images.unsplash.com/photo-1541888086925-eb196c21d44a?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80",
          video: "",
          desc: "Réalisation du centre commercial City Mall à Constantine en tant que Chef de projet."
        }
      ]
    };

    let siteData = JSON.parse(localStorage.getItem('portfolioData')) || defaultData;

    // --- Render Posts ---
    function renderPosts() {
      const container = document.getElementById('blog-container');
      container.innerHTML = '';
      
      siteData.posts.forEach(post => {
        let videoHTML = '';
        if(post.video) {
          let videoId = post.video.split('v=')[1] || post.video.split('be/')[1];
          if(videoId) {
            videoHTML = `
              <div class="ratio ratio-16x9 mt-3 rounded shadow-sm">
                <iframe src="https://www.youtube.com/embed/${videoId}" allowfullscreen></iframe>
              </div>`;
          }
        }

        container.innerHTML += `
          <div class="col-md-6 col-lg-4 reveal active">
            <div class="card h-100">
              <img src="${post.image || 'https://via.placeholder.com/400x200'}" class="card-img-top blog-img" alt="${post.title}">
              <div class="card-body">
                <h5 class="card-title text-primary fw-bold">${post.title}</h5>
                <p class="card-text text-muted small">${post.desc}</p>
                ${videoHTML}
              </div>
            </div>
          </div>
        `;
      });
    }

    // --- Load Profile Image ---
    function loadProfileImage() {
      document.getElementById('profile-img').src = siteData.profileImage;
    }

    // --- Admin Panel ---
    function toggleAdmin() {
      document.getElementById('adminPanel').classList.toggle('active');
    }

    function uploadProfile() {
      const fileInput = document.getElementById('profileUpload');
      if (!fileInput.files[0]) return alert("Veuillez choisir une image.");
      
      const reader = new FileReader();
      reader.onload = function(e) {
        siteData.profileImage = e.target.result;
        saveData();
        loadProfileImage();
        alert("Photo de profil mise à jour ! N'oubliez pas de télécharger data.json.");
      };
      reader.readAsDataURL(fileInput.files[0]);
    }

    function addPost() {
      const title = document.getElementById('postTitle').value;
      const image = document.getElementById('postImage').value;
      const video = document.getElementById('postVideo').value;
      const desc = document.getElementById('postDesc').value;

      if (!title) return alert("Le titre est obligatoire.");

      siteData.posts.unshift({ id: Date.now(), title, image, video, desc });
      saveData();
      renderPosts();
      
      document.getElementById('postTitle').value = '';
      document.getElementById('postImage').value = '';
      document.getElementById('postVideo').value = '';
      document.getElementById('postDesc').value = '';
      alert("Article publié avec succès ! N'oubliez pas de télécharger data.json.");
    }

    function saveData() {
      localStorage.setItem('portfolioData', JSON.stringify(siteData));
    }

    // --- Export Data ---
    function exportData() {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(siteData));
      const downloadAnchorNode = document.createElement('a');
      downloadAnchorNode.setAttribute("href", dataStr);
      downloadAnchorNode.setAttribute("download", "data.json");
      document.body.appendChild(downloadAnchorNode);
      downloadAnchorNode.click();
      downloadAnchorNode.remove();
      alert("Fichier data.json téléchargé. Placez-le à côté de index.html sur GitHub !");
    }

    // --- Initial Load ---
    fetch('data.json')
      .then(response => response.json())
      .then(data => {
        siteData = data;
        saveData();
        renderPosts();
        loadProfileImage();
      })
      .catch(() => {
        renderPosts();
        loadProfileImage();
      });

  </script>
</body>
