  <style>
    :root {
      --primary: #0f2744;
      --secondary: #1a3a5c;
      --gold: #c9a227;
      --gold-hover: #e0b82e;
      --light: #f4f7f6;
      --text: #333;
    }
    body { 
      font-family: 'Poppins', sans-serif; 
      background-color: var(--light); 
      color: var(--text); 
      overflow-x: hidden;
    }
    
    /* Animations */
    .reveal { opacity: 0; transform: translateY(30px); transition: all 0.8s ease-out; }
    .reveal.active { opacity: 1; transform: translateY(0); }

    /* Navbar */
    .navbar { background-color: var(--primary); padding: 15px 0; transition: 0.3s; }
    .navbar.scrolled { box-shadow: 0 4px 10px rgba(0,0,0,0.2); padding: 10px 0; }
    .navbar-brand { color: white !important; font-weight: 700; font-size: 1.5rem; display: flex; align-items: center; gap: 10px; }
    .nav-link { color: rgba(255,255,255,0.8) !important; font-weight: 500; position: relative; }
    .nav-link::after { content: ''; position: absolute; width: 0; height: 2px; bottom: 0; left: 0; background: var(--gold); transition: 0.3s; }
    .nav-link:hover::after { width: 100%; }
    .nav-link:hover { color: var(--gold) !important; }
    
    /* Hero */
    .hero { background: linear-gradient(135deg, var(--primary), var(--secondary)); color: white; padding: 120px 0 80px; position: relative; }
    .hero-img { width: 280px; height: 280px; border-radius: 50%; border: 6px solid var(--gold); object-fit: cover; box-shadow: 0 15px 35px rgba(0,0,0,0.4); transition: transform 0.4s; }
    .hero-img:hover { transform: scale(1.03); }
    .hero h1 { font-weight: 700; font-size: 2.8rem; margin-bottom: 10px; }
    .hero .title { color: var(--gold); font-size: 1.3rem; font-weight: 600; letter-spacing: 1px; }
    .btn-custom-gold { background: var(--gold); color: #111; font-weight: 600; border: none; padding: 12px 30px; border-radius: 30px; transition: 0.3s; }
    .btn-custom-gold:hover { background: var(--gold-hover); transform: translateY(-3px); box-shadow: 0 8px 20px rgba(201, 162, 39, 0.4); }
    
    /* Sections */
    .section-title { color: var(--primary); font-weight: 700; margin-bottom: 40px; position: relative; display: inline-block; font-size: 2rem; }
    .section-title::after { content: ''; position: absolute; width: 60%; height: 4px; background: var(--gold); bottom: -12px; left: 0; border-radius: 2px; }
    
    /* Cards */
    .card { border: none; border-radius: 15px; box-shadow: 0 8px 25px rgba(0,0,0,0.06); transition: transform 0.3s, box-shadow 0.3s; background: white; }
    .card:hover { transform: translateY(-6px); box-shadow: 0 12px 30px rgba(0,0,0,0.1); }
    .timeline-card { border-left: 5px solid var(--gold); }
    .timeline-card h5 { color: var(--primary); }
    
    /* Skills */
